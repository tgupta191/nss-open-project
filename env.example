# Welfare Scheme Chatbot Configuration

# Environment configuration (development / production)
ENV=development
DEBUG=True

# SQLite URL (default)
DATABASE_URL=sqlite:///./welfare_chatbot.db

# API Keys (Optional - Fallbacks to mock responses if left blank)
# Obtain a free key from console.groq.com
GROQ_API_KEY=

# Obtain a HuggingFace token from huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Bhashini translation service details
BHASHINI_API_KEY=

# Security secret key
API_SECRET_KEY=hackathon-super-secret-key-12345

# Rate Limits (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
